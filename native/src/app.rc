// Resources for the Icewind Dale Almanac (native build): icon, manifest, the 12 scenes.
// Paths are resolved through windres --include-dir=src (see build.sh).
#include <winver.h>

1 ICON "../../Images/auril.ico"

1 24 "app.manifest"

// Scene images, one per weather event id (resource id = 100 + event id).
101 RCDATA "../assets/w01.jpg"
102 RCDATA "../assets/w02.jpg"
103 RCDATA "../assets/w03.jpg"
104 RCDATA "../assets/w04.jpg"
105 RCDATA "../assets/w05.jpg"
106 RCDATA "../assets/w06.jpg"
107 RCDATA "../assets/w07.jpg"
108 RCDATA "../assets/w08.jpg"
109 RCDATA "../assets/w09.jpg"
110 RCDATA "../assets/w10.jpg"
111 RCDATA "../assets/w11.jpg"
112 RCDATA "../assets/w12.jpg"

// 360x120 copies for the timeline strip and calendar thumbnails (resource id = 200 + event
// id), so a full scene is decoded only for the hero. Made by native/build.sh from w01..w12
// when ImageMagick is present (assets/t01..t12.jpg).
201 RCDATA "../assets/t01.jpg"
202 RCDATA "../assets/t02.jpg"
203 RCDATA "../assets/t03.jpg"
204 RCDATA "../assets/t04.jpg"
205 RCDATA "../assets/t05.jpg"
206 RCDATA "../assets/t06.jpg"
207 RCDATA "../assets/t07.jpg"
208 RCDATA "../assets/t08.jpg"
209 RCDATA "../assets/t09.jpg"
210 RCDATA "../assets/t10.jpg"
211 RCDATA "../assets/t11.jpg"
212 RCDATA "../assets/t12.jpg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Icewind Dale Almanac - weather helper"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "IcewindDaleWeatherHelper"
            VALUE "OriginalFilename", "IcewindDaleWeatherHelper.exe"
            VALUE "ProductName", "Icewind Dale Almanac"
            VALUE "ProductVersion", "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
